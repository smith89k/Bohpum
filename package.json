{
  "name": "bohpum",
  "productName": "Bohpum",
  "version": "0.3.2",
  "description": "Bohpum (បោះពុម្ព) - desktop publishing app that opens Microsoft Publisher .pub files",
  "main": "main.js",
  "author": "Sunnguon TAING",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "bundle-libreoffice": "node scripts/bundle-libreoffice.js",
    "reader-pack": "node scripts/reader-pack.js",
    "dist": "node scripts/check-notes.js && node scripts/build-explorer-menu.js && electron-builder --win nsis --publish never",
    "dist:store": "node scripts/check-notes.js && node scripts/build-explorer-menu.js && electron-builder --win appx --publish never --config build/store.config.js",
    "build:menu": "node scripts/build-explorer-menu.js",
    "icons": "electron scripts/make-icons.js"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kh.bohpum.app",
    "productName": "Bohpum",
    "files": [
      "main.js",
      "preload.js",
      "explorer-menu.js",
      "updater.js",
      "reader.js",
      "store.js",
      "store-update.js",
      "list.js",
      "update-config.json",
      "reader-pack.json",
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "explorer-menu/out",
        "to": "explorer-menu",
        "filter": [
          "BohpumMenu.dll",
          "Bohpum.ExplorerMenu.msix"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "https://bohpum-update.smith89k.com/"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "Bohpum-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "bpum",
        "name": "Bohpum.Document",
        "description": "Bohpum publication",
        "role": "Editor",
        "icon": "build/bpum.ico"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
