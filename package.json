{
  "name": "bohpum",
  "productName": "Bohpum",
  "version": "0.1.0",
  "description": "Bohpum (បោះពុម្ព) - desktop publishing app that opens Microsoft Publisher .pub files",
  "main": "main.js",
  "author": "Sunnguon TAING",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "bundle-libreoffice": "node scripts/bundle-libreoffice.js",
    "dist": "node scripts/check-notes.js && node scripts/bundle-libreoffice.js && node scripts/build-explorer-menu.js && electron-builder --win nsis",
    "build:menu": "node scripts/build-explorer-menu.js",
    "icons": "electron scripts/make-icons.js"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kh.bohpum.app",
    "productName": "Bohpum",
    "files": [
      "main.js",
      "preload.js",
      "explorer-menu.js",
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "vendor/libreoffice",
        "to": "libreoffice"
      },
      {
        "from": "explorer-menu/out",
        "to": "explorer-menu",
        "filter": [
          "BohpumMenu.dll",
          "Bohpum.ExplorerMenu.msix"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "bpum",
        "name": "Bohpum.Document",
        "description": "Bohpum publication",
        "role": "Editor",
        "icon": "build/bpum.ico"
      }
    ]
  }
}
