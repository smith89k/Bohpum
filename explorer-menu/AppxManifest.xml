<?xml version="1.0" encoding="utf-8"?>
<!-- Bohpum — sparse package that puts BohpumMenu.dll ("Convert to Bohpum" on .pub files) in the first Windows 11 right-click menu.
     Unsigned: the OID in Publisher is what Windows requires for that (added from an elevated session).
     Keep Version and the CLSID in step with explorer-menu.js and menu.cpp (scripts/build-explorer-menu.js checks). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="Bohpum.ExplorerMenu" Publisher="CN=Bohpum, OID.2.25.311729368913984317654407730594956997722=1"
    Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Bohpum Explorer menu</DisplayName>
    <PublisherDisplayName>Sunnguon Taing</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="Bohpum" Executable="Bohpum.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="Bohpum Explorer menu" Description="Bohpum right-click menu for Publisher files"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".pub">
              <desktop5:Verb Id="Bohpum" Clsid="1e11f0a8-6fc0-4a9c-9031-6924b71a4d77" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Bohpum Explorer menu">
              <com:Class Id="1e11f0a8-6fc0-4a9c-9031-6924b71a4d77" Path="resources\explorer-menu\BohpumMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
