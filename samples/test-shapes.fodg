 <office:body>
  <office:drawing>
   <draw:page draw:name="page1" draw:style-name="dp2" draw:master-page-name="PM0">
    <draw:custom-shape draw:style-name="gx1" draw:text-style-name="Px" svg:width="40mm" svg:height="15mm" svg:x="5mm" svg:y="4mm">
      <text:p text:style-name="Px"><text:span text:style-name="Tx">វិញ្ញាបនបត្រ</text:span></text:p>
      <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/>
    </draw:custom-shape>
    <draw:ellipse draw:style-name="gx2" svg:width="20mm" svg:height="12mm" svg:x="50mm" svg:y="5mm"/>
    <draw:line draw:style-name="gx3" svg:x1="5mm" svg:y1="25mm" svg:x2="60mm" svg:y2="40mm"/>
    <draw:path draw:style-name="gx5" svg:width="20mm" svg:height="20mm" svg:x="80mm" svg:y="4mm" svg:viewBox="0 0 2000 2000" svg:d="M1000 0 L1300 700 L2000 750 L1450 1200 L1650 2000 L1000 1550 L350 2000 L550 1200 L0 750 L700 700 Z"/>
    <draw:g>
      <draw:rect draw:style-name="gx3" svg:width="15mm" svg:height="10mm" svg:x="70mm" svg:y="35mm"/>
      <draw:ellipse draw:style-name="gx5" svg:width="8mm" svg:height="8mm" svg:x="90mm" svg:y="36mm"/>
    </draw:g>
    <draw:frame draw:style-name="gx4" svg:width="30mm" svg:height="20mm" draw:transform="rotate (0.2618) translate (20mm 32mm)"><draw:image><office:binary-data></office:binary-data></draw:image></draw:frame>
    <draw:frame draw:style-name="gx4" svg:width="35mm" svg:height="8mm" draw:transform="rotate (-0.5236) translate (65mm 50mm)"><draw:text-box><text:p text:style-name="Px"><text:span text:style-name="Tx">Rotated ខ្មែរ</text:span></text:p></draw:text-box></draw:frame>
</draw:page>
  </office:drawing>
 </office:body>
</office:document>